rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if owns(uid) && request.resource.data.role == 'citizen';
      allow update: if isAdmin() || (owns(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /incidents/{incidentId} {
      allow create: if signedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow read: if signedIn() && (resource.data.reportedBy == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (signedIn() && resource.data.reportedBy == request.auth.uid && request.resource.data.reportedBy == resource.data.reportedBy);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create, delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if isAdmin(); }
  }
}
